<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="rtl"
    android:orientation="vertical">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="12dp">

            <!-- Header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:importantForAccessibility="no"
                    android:scaleType="fitCenter"
                    android:src="@drawable/logo_mark" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:fontFamily="@font/plex_semibold"
                    android:text="تحويل"
                    android:textColor="@color/text"
                    android:textSize="28sp" />

                <ImageButton
                    android:id="@+id/btnHistory"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:layout_marginEnd="10dp"
                    android:background="@drawable/circle_card"
                    android:contentDescription="السجل"
                    android:src="@drawable/ic_history" />

                <ImageButton
                    android:id="@+id/btnSettings"
                    android:layout_width="42dp"
                    android:layout_height="42dp"
                    android:background="@drawable/circle_card"
                    android:contentDescription="الإعدادات"
                    android:src="@drawable/ic_sliders" />
            </LinearLayout>

            <!-- Wallet card -->
            <LinearLayout
                android:id="@+id/walletCard"
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginTop="22dp"
                android:background="@drawable/grad_card"
                android:elevation="6dp"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/fromAccount"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/plex_medium"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/codeLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:alpha="0.75"
                        android:textColor="#FFFFFF"
                        android:textSize="13sp" />
                </LinearLayout>

                <Space
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.8"
                    android:text="المبلغ"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical|right"
                    android:layoutDirection="ltr">

                    <EditText
                        android:id="@+id/amount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="40dp"
                        android:background="@null"
                        android:fontFamily="@font/plex_semibold"
                        android:gravity="center_vertical|right"
                        android:hint="0"
                        android:importantForAutofill="no"
                        android:inputType="numberDecimal"
                        android:maxLength="9"
                        android:padding="0dp"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#80FFFFFF"
                        android:textDirection="ltr"
                        android:textSize="46sp" />

                    <TextView
                        android:id="@+id/currency"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:alpha="0.85"
                        android:fontFamily="@font/plex_medium"
                        android:text="₪"
                        android:textColor="#FFFFFF"
                        android:textSize="30sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Setup needed -->
            <LinearLayout
                android:id="@+id/setupCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:background="@drawable/row_bg"
                android:gravity="center_vertical"
                android:padding="14dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/setupIcon"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/circle_warn"
                    android:scaleType="center"
                    android:src="@drawable/ic_shield" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/setupTitle"
                        style="@style/RowTitle"
                        android:fontFamily="@font/plex_medium"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/setupSub"
                        style="@style/Label"
                        android:layout_marginTop="1dp"
                        android:textSize="12sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron" />
            </LinearLayout>

            <!-- Recipient -->
            <TextView
                style="@style/Label"
                android:layout_marginStart="4dp"
                android:layout_marginTop="26dp"
                android:text="إلى"
                android:textSize="14sp" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/people"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <EditText
                android:id="@+id/phone"
                style="@style/Field"
                android:layout_marginTop="16dp"
                android:fontFamily="@font/plex_medium"
                android:hint="رقم جوال المستلم"
                android:inputType="phone"
                android:maxLength="15"
                android:textSize="18sp" />

            <!-- Last result -->
            <LinearLayout
                android:id="@+id/resultCard"
                style="@style/Card"
                android:layout_marginTop="22dp"
                android:padding="16dp"
                android:visibility="gone">

                <TextView
                    style="@style/Label"
                    android:text="آخر عملية"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/result"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@color/text"
                    android:textIsSelectable="true"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingTop="8dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp">

        <Button
            android:id="@+id/btnSend"
            style="@style/PrimaryButton"
            android:fontFamily="@font/plex_semibold"
            android:text="متابعة" />
    </FrameLayout>
</LinearLayout>
